# autonomous-content-bot 環境変数
# このファイルを .env にコピーして値を設定してください。
# 注意: src/generator.py は os.environ.get() で直接読むため、
#       実行前に `export $(cat .env | xargs)` 等でシェルに読み込ませるか、
#       python-dotenv を requirements.txt に追加して明示的にロードする必要があります。

# 記事生成フォールバック(src/generator.py)・判断ステップ(src/judge.py)で使用。
# 未設定ならダミー出力/簡易判定になります。
ANTHROPIC_API_KEY=

# AdSense収益トラッキング(src/revenue_tracker.py, config.yaml: revenue.source: adsense_api)
# AdSense審査承認後、Google Cloud ConsoleでOAuthクライアントを作成し取得してください。
# 未設定の場合、収益取得は「未設定のためスキップ」としてエラーにせず継続します。
ADSENSE_CLIENT_ID=
ADSENSE_CLIENT_SECRET=
ADSENSE_REFRESH_TOKEN=
ADSENSE_ACCOUNT_ID=

# ニッチ探索のギャップ検出精度向上(src/niche_scanner.py)
# https://serper.dev/ で取得したAPIキー(SerpApi等より低コスト)。
# 未設定ならpytrendsの関心度のみで近似します。
SERPER_API_KEY=
